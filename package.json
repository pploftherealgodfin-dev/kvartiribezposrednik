{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.node.json",
    "test:ux": "node --test tests/ux-flows.test.mjs",
    "test:seo": "node --test tests/seo-output.test.mjs",
    "test:flows": "node scripts/test-flows.mjs",
    "verify": "npm run type-check && npm run lint && npm run test:ux && npm run test:flows && npm run build && npm run test:seo && npm run test:release",
    "test:release": "node --test --test-reporter=spec tests/release-safety.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "i18next": "^25.3.2",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^7.6.3",
    "recharts": "3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jiti": "^2.6.1",
    "jsdom": "27.0.1",
    "postcss": "^8.5.6",
    "remixicon": "4.5.0",
    "source-map": "^0.7.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "unplugin-auto-import": "^19.3.0",
    "vite": "^8.0.1"
  }
}
